# Copy this file to terraform.tfvars (gitignored) and fill in real values.
#
# hcloud_token NÃO é setado aqui: exporte TF_VAR_hcloud_token no shell antes de
# rodar build.hetzner.sh. O mesmo token é consumido pelo envs/hetzner (criação
# do cluster) e pelo platform/hetzner (Hetzner CSI Driver).

remote_state_bucket  = "CHANGE_ME-terraform-state"
remote_state_region  = "us-east-1"
remote_state_env_key = "workerless-terraforms/envs/hetzner/terraform.tfstate"
# remote_state_profile = "default"

# Must match envs/hetzner's prometheus_node_port.
prometheus_node_port = 30090

plans = {
  starter = {
    quota = {
      "requests.cpu"    = "2"
      "requests.memory" = "1Gi"
      "limits.cpu"      = "5"
      "limits.memory"   = "5Gi"
      "pods"            = "15"
    }

    container = {
      default_cpu            = "250m"
      default_memory         = "256Mi"
      default_request_cpu    = "100m"
      default_request_memory = "128Mi"
      max_cpu                = "500m"
      max_memory             = "512Mi"
    }

    max_replicas = 10
  }

  growth = {
    quota = {
      "requests.cpu"    = "4"
      "requests.memory" = "4Gi"
      "limits.cpu"      = "10"
      "limits.memory"   = "10Gi"
      "pods"            = "30"
    }

    container = {
      default_cpu            = "500m"
      default_memory         = "512Mi"
      default_request_cpu    = "250m"
      default_request_memory = "256Mi"
      max_cpu                = "1000m"
      max_memory             = "1Gi"
    }

    max_replicas = 20
  }
}

workloads = {
  "orders-consumer" = {
    tenant_id    = "acme"
    plan_key     = "starter"
    worker_image = "ghcr.io/acme/orders-consumer:1.2.3"

    # External Secrets extracts all key/value pairs from backend key
    # "acme-orders-consumer-credentials" and creates
    # "orders-consumer-credentials" in the workload namespace.
    external_secret_ref = {
      secret_store_name = "tenant-secrets"
      secret_store_kind = "ClusterSecretStore"
    }

    event_source_egress_rules = [{
      cidr = "203.0.113.10/32"
      ports = [
        { port = 5671 },
      ]
    }]

    keda_triggers = [{
      type = "rabbitmq"
      metadata = {
        queueName = "acme-orders"
        mode      = "QueueLength"
        value     = "5"
      }
      authentication_secret_refs = [{
        parameter = "host"
        key       = "RABBITMQ_CONNECTION_STRING"
      }]
    }]
  }

  "billing-consumer" = {
    tenant_id    = "globex"
    plan_key     = "growth"
    worker_image = "ghcr.io/globex/billing-consumer:4.5.6"
    min_replicas = 1

    external_secret_ref = {
      secret_store_name = "tenant-secrets"
      secret_store_kind = "ClusterSecretStore"
    }

    event_source_egress_rules = [{
      cidr = "198.51.100.20/32"
      ports = [
        { port = 5671 },
      ]
    }]

    image_pull_secret_refs = ["globex-registry"]

    metrics = {
      enabled   = true
      port_name = "metrics"
      port      = 9090
      path      = "/metrics"
    }

    probes = {
      readiness = {
        http_get = {
          path = "/ready"
          port = "metrics"
        }
      }
      liveness = {
        http_get = {
          path = "/health"
          port = "metrics"
        }
      }
    }

    keda_polling_interval = 30
    keda_cooldown_period  = 60
    keda_triggers = [{
      type = "rabbitmq"
      metadata = {
        queueName = "globex-billing"
        mode      = "QueueLength"
        value     = "10"
        protocol  = "amqp"
      }
      authentication_secret_refs = [{
        parameter = "host"
        key       = "RABBITMQ_CONNECTION_STRING"
      }]
    }]
  }
}
