# Copy this file to terraform.tfvars (gitignored) and fill in real values.
#
# hcloud_token NÃO é setado aqui: exporte TF_VAR_hcloud_token no shell antes de
# rodar build.hetzner.sh. O mesmo token é consumido pelo envs/hetzner (criação
# do cluster) e pelo platform/hetzner (Hetzner CSI Driver).

remote_state_bucket      = "CHANGE_ME-r2-bucket"
remote_state_region      = "auto"
remote_state_env_key     = "workerless-terraforms/envs/hetzner/terraform.tfstate"
remote_state_s3_endpoint = "https://CHANGE_ME_ACCOUNT_ID.r2.cloudflarestorage.com"

# Production reaches Prometheus through the authenticated Cloudflare Tunnel.
prometheus_node_port = null

# Enable only after creating workerless-system/workerless-cloudflared-tunnel
# with key `token` from the workerless-api Terraform Tunnel output.
cloudflared_connector_enabled          = false
cloudflared_tunnel_token_secret_name  = "workerless-cloudflared-tunnel"

# -----------------------------------------------------------------------
# Workerless Security Guard. Profile notes:
#
# - Local (platform/local): every *_enabled flag defaults false in main.tf
#   — no fake resources, no placeholder credentials.
# - Staging: this repo has no native "staging" Terraform directory. Stand
#   up a SECOND, isolated Hetzner deployment (own backend.hcl key, own
#   hcloud project if possible, own Cloudflare zone/account, own R2 bucket,
#   own tailnet) using this exact envs/hetzner + platform/hetzner pair, and
#   point every variable below at that isolated set of resources. Never
#   reuse production's Cloudflare zone, R2 bucket, or tailnet for staging.
# - Production: set is_production = true below to arm the production-only
#   validations (tailscale proxy_group_replicas >= 2,
#   r2_evidence_retention_days >= 365).
#
# Every *_enabled flag below is false until filled in — CHANGE_ME values
# are placeholders, not usable defaults.
# -----------------------------------------------------------------------

is_production = false # set true only for the real production deployment

# Required when is_production = true. Collect requests, init-container maxima,
# pod overhead, DaemonSets, pending pods, PVCs and placement constraints.
# Commercial consumer reservations belong exclusively to workerless-api.
n_minus_one_capacity_snapshot = null

security_guard_grpc_enabled           = false
guard_grpc_image                      = "ghcr.io/workerless/security-guard-grpc:CHANGE_ME"
guard_grpc_tailnet_hostname           = "guard-grpc.CHANGE_ME.ts.net"
guard_grpc_db_egress_cidr             = "CHANGE_ME/32"
guard_grpc_db_credentials_secret_ref = {
  secret_store_name = "tenant-secrets"
  secret_store_kind = "ClusterSecretStore"
}

tailscale_operator_enabled = false # true enables private kubectl access through Tailscale
# Export via TF_VAR_tailscale_tf_oauth_client_id / TF_VAR_tailscale_tf_oauth_client_secret
# — never commit real values here. This is the Terraform-PROVIDER's own
# credential (owns the full tailscale_acl), distinct from
# tailscale_oauth_secret_ref below (the in-cluster Operator's own OAuth client).
tailscale_operator_tag        = "tag:guard-operator"
tailscale_proxy_tag           = "tag:guard-proxy"
tailscale_allowed_device_tags = ["tag:guard-admin-mac"]
# Each tag above receives Kubernetes cluster-admin through a ClusterRoleBinding.
# Use a dedicated tag assigned only to managed administrator devices.
tailscale_oauth_secret_ref = {
  secret_store_name = "tenant-secrets"
  secret_store_kind = "ClusterSecretStore"
}

cloudflare_operational_blocking_enabled = false
# Export via TF_VAR_cloudflare_waf_api_token — distinct from cloudflare_r2_api_token below.
cloudflare_account_id              = "CHANGE_ME"
cloudflare_zone_ids                = ["CHANGE_ME"]
cloudflare_guard_list_name         = "workerless_guard_block_prod"
cloudflare_guard_rule_expression   = "(ip.src in $workerless_guard_block_prod)"
cloudflare_protected_endpoints     = ["guard-api.example.com"]
cloudflare_guard_token_backend_key = "cloudflare-guard-runtime-token"
cloudflare_guard_token_secret_ref = {
  secret_store_name = "tenant-secrets"
  secret_store_kind = "ClusterSecretStore"
}

r2_evidence_enabled = false
# Export via TF_VAR_cloudflare_r2_api_token — distinct from cloudflare_waf_api_token above.
r2_evidence_bucket_name    = "workerless-guard-evidence-prod"
r2_evidence_retention_days = 365 # must stay >= 365 once is_production = true
r2_evidence_token_secret_ref = {
  secret_store_name = "tenant-secrets"
  secret_store_kind = "ClusterSecretStore"
}

security_datastore_acl_enabled = false
postgresql_host                = "CHANGE_ME"
postgresql_database            = "security"
postgresql_security_tables     = ["events", "alerts"]
# postgresql_admin_credentials_secret_ref / kafka_admin_credentials_secret_ref
# are live-connection bootstrap credentials (the postgresql/kafka providers
# connect at plan/apply time) — export via TF_VAR_*, never commit here.
kafka_bootstrap_servers   = ["CHANGE_ME:9092"]
kafka_api_principal       = "User:security-guard-api"
kafka_collector_principal = "User:security-collector"

security_monitoring_enabled  = false
falco_image_digest           = "CHANGE_ME_64_HEX_SHA256_DIGEST"
audit_ingestion_allowed_cidr = "10.10.1.0/24" # k3s control-plane private CIDR, see envs/hetzner
collector_image               = "ghcr.io/workerless/security-collector:CHANGE_ME"
collector_watched_resources = [
  { api_groups = [""], resources = ["pods"], verbs = ["get", "list", "watch"] },
  { api_groups = ["apps"], resources = ["deployments"], verbs = ["get", "list", "watch"] },
  { api_groups = [""], resources = ["events"], verbs = ["get", "list", "watch"] },
]

plans = {
  starter = {
    quota = {
      "requests.cpu"    = "2"
      "requests.memory" = "1Gi"
      "limits.cpu"      = "5"
      "limits.memory"   = "5Gi"
      "pods"            = "15"
    }

    container = {
      default_cpu            = "250m"
      default_memory         = "256Mi"
      default_request_cpu    = "100m"
      default_request_memory = "128Mi"
      max_cpu                = "500m"
      max_memory             = "512Mi"
    }

    max_replicas = 10
  }

  growth = {
    quota = {
      "requests.cpu"    = "4"
      "requests.memory" = "4Gi"
      "limits.cpu"      = "10"
      "limits.memory"   = "10Gi"
      "pods"            = "30"
    }

    container = {
      default_cpu            = "500m"
      default_memory         = "512Mi"
      default_request_cpu    = "250m"
      default_request_memory = "256Mi"
      max_cpu                = "1000m"
      max_memory             = "1Gi"
    }

    max_replicas = 20
  }
}

workloads = { # MUST remain {} when is_production = true
  "orders-consumer" = {
    tenant_id    = "acme"
    plan_key     = "starter"
    worker_image = "ghcr.io/acme/orders-consumer:1.2.3"

    # External Secrets extracts all key/value pairs from backend key
    # "acme-orders-consumer-credentials" and creates
    # "orders-consumer-credentials" in the workload namespace.
    external_secret_ref = {
      secret_store_name = "tenant-secrets"
      secret_store_kind = "ClusterSecretStore"
    }

    event_source_egress_rules = [{
      cidr = "203.0.113.10/32"
      ports = [
        { port = 5671 },
      ]
    }]

    keda_triggers = [{
      type = "rabbitmq"
      metadata = {
        queueName = "acme-orders"
        mode      = "QueueLength"
        value     = "5"
      }
      authentication_secret_refs = [{
        parameter = "host"
        key       = "RABBITMQ_CONNECTION_STRING"
      }]
    }]
  }

  "billing-consumer" = {
    tenant_id    = "globex"
    plan_key     = "growth"
    worker_image = "ghcr.io/globex/billing-consumer:4.5.6"
    min_replicas = 1

    external_secret_ref = {
      secret_store_name = "tenant-secrets"
      secret_store_kind = "ClusterSecretStore"
    }

    event_source_egress_rules = [{
      cidr = "198.51.100.20/32"
      ports = [
        { port = 5671 },
      ]
    }]

    image_pull_secret_refs = ["globex-registry"]

    metrics = {
      enabled   = true
      port_name = "metrics"
      port      = 9090
      path      = "/metrics"
    }

    probes = {
      readiness = {
        http_get = {
          path = "/ready"
          port = "metrics"
        }
      }
      liveness = {
        http_get = {
          path = "/health"
          port = "metrics"
        }
      }
    }

    keda_polling_interval = 30
    keda_cooldown_period  = 60
    keda_triggers = [{
      type = "rabbitmq"
      metadata = {
        queueName = "globex-billing"
        mode      = "QueueLength"
        value     = "10"
        protocol  = "amqp"
      }
      authentication_secret_refs = [{
        parameter = "host"
        key       = "RABBITMQ_CONNECTION_STRING"
      }]
    }]
  }
}
