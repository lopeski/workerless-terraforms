# Copy this file to terraform.tfvars (gitignored) and fill in real values.
#
# hcloud_token NÃO é setado aqui: exporte TF_VAR_hcloud_token no shell antes de
# rodar build.hetzner.sh. O mesmo token é consumido pelo envs/hetzner (criação
# do cluster) e pelo platform/hetzner (Hetzner CSI Driver).

remote_state_bucket  = "CHANGE_ME-terraform-state"
remote_state_region  = "us-east-1"
remote_state_env_key = "workerless-terraforms/envs/hetzner/terraform.tfstate"
# remote_state_profile = "default"

# Must match envs/hetzner's prometheus_node_port.
prometheus_node_port = 30090

plans = {
  starter = {
    quota = {
      "requests.cpu"    = "2"
      "requests.memory" = "1Gi"
      "limits.cpu"      = "5"
      "limits.memory"   = "5Gi"
      "pods"            = "15"
    }

    container = {
      default_cpu            = "250m"
      default_memory         = "256Mi"
      default_request_cpu    = "100m"
      default_request_memory = "128Mi"
      max_cpu                = "500m"
      max_memory             = "512Mi"
    }

    max_replicas = 10
  }

  growth = {
    quota = {
      "requests.cpu"    = "4"
      "requests.memory" = "4Gi"
      "limits.cpu"      = "10"
      "limits.memory"   = "10Gi"
      "pods"            = "30"
    }

    container = {
      default_cpu            = "500m"
      default_memory         = "512Mi"
      default_request_cpu    = "250m"
      default_request_memory = "256Mi"
      max_cpu                = "1000m"
      max_memory             = "1Gi"
    }

    max_replicas = 20
  }
}

# Required when registry_enabled=true. First apply envs/hetzner, create this
# DNS A record pointing to registry_load_balancer_ipv4, then create the
# harbor/harbor-admin Secret through the secrets backend before this apply.
registry_enabled           = true
registry_domain            = "registry.example.com"
acme_email                 = "platform@example.com"
registry_storage_class     = "hcloud-volumes"
registry_admin_secret_name = "harbor-admin"

workloads = {
  "orders-consumer" = {
    tenant_id    = "acme"
    plan_key     = "starter"
    worker_image = "ghcr.io/acme/orders-consumer:1.2.3"

    # External Secrets extracts all key/value pairs from backend key
    # "orders-consumer-credentials" and creates a Kubernetes Secret with
    # the same name in the workload namespace.
    external_secret_ref = {
      name              = "orders-consumer-credentials"
      secret_store_name = "tenant-secrets"
      secret_store_kind = "ClusterSecretStore"
    }

    event_source_egress_rules = [{
      cidr = "203.0.113.10/32"
      ports = [
        { port = 5671 },
      ]
    }]

    keda_triggers = [{
      type = "rabbitmq"
      metadata = {
        queueName   = "acme-orders"
        mode        = "QueueLength"
        value       = "5"
        hostFromEnv = "RABBITMQ_CONNECTION_STRING"
      }
    }]
  }

  "billing-consumer" = {
    tenant_id    = "globex"
    plan_key     = "growth"
    worker_image = "ghcr.io/globex/billing-consumer:4.5.6"
    min_replicas = 1

    external_secret_ref = {
      name              = "billing-consumer-credentials"
      secret_store_name = "tenant-secrets"
      secret_store_kind = "ClusterSecretStore"
    }

    event_source_egress_rules = [{
      cidr = "198.51.100.0/24"
      ports = [
        { port = 9093 },
      ]
    }]

    keda_triggers = [{
      type = "kafka"
      metadata = {
        bootstrapServers = "broker-1.example.com:9093,broker-2.example.com:9093"
        consumerGroup    = "globex-billing"
        topic            = "billing-events"
        lagThreshold     = "10"
      }
    }]
  }
}
